# 服务
PORT=4000
JWT_SECRET="请替换为至少32位的随机字符串"
# Render 持久磁盘可设置为 /var/data/essay-grader/db.json
DATA_FILE="./server/data/db.json"

# 真实 AI（出题、批改、讲评与学习建议）
AI_MODE="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
# 生产环境建议 false，避免 API 失败后悄悄返回低质量演示结果
AI_FALLBACK_TO_MOCK="false"
ENABLE_WEB_SEARCH="false"

# 腾讯云手写体 OCR（整张答题卡识别）
OCR_PROVIDER="tencent"
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
TENCENT_REGION="ap-guangzhou"

# Netlify 构建前端时使用（末尾必须包含 /api）
VITE_API_BASE_URL="https://jinq2804-ux.onrender.com/api"
